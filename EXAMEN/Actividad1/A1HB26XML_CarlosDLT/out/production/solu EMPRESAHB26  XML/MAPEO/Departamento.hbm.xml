<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="POJOS.Departamento" table="DEPARTAMENTO" schema="dbo" catalog="EMPRESAHB26">
        <id name="numDepartamento" type="int">
            <column name="NumDepartamento" />
            <generator class="increment" />
        </id>
        <property name="nomeDepartamento" type="string">
            <column name="NomeDepartamento" length="25" not-null="true" unique="true" />
        </property>
        <!--Mapeo de las funciones de un departamento como set de componentes-->
        <set name="funciones" table="DEPARTAMENTOFUNCION"  >
            <key column="NumDepartamento"/> 
            <element column="Funcion"  type="string"/>            
        </set>
        <!--  empregados que pertenecen a un departamento   -->
        <set name="empregados" table="EMPREGADO" inverse="true" lazy="true" fetch="select">
            <key>
                <column name="NumDepartamentoPertenece"/>
            </key>
            <one-to-many class="POJOS.Empregado"/>
        </set>
    
        <!--  mapeo del director de un departamento, tiene que ser un empleado fijo -->
        <many-to-one class="POJOS.Empregadofixo" name="director"  unique="true" fetch="select">
            <column length="15" name="NSSDirector" not-null="true"/>
        </many-to-one>
           
        <!--  mapeo de los proyectos que controla  un departamento  -->
        <set name="proxectos" table="PROXECTO" inverse="true" lazy="true" fetch="select">
            <key>
                <column name="NumDepartControla" not-null="true"/>
            </key>
            <one-to-many class="POJOS.Proxecto"/>
        </set>
        <!--  mapeo de los lugares que controla  un departamento  -->
        <set name="lugares" table="LUGAR" inverse="true"  cascade="all-delete-orphan" lazy="true" fetch="select"> 
            <key> 
                <column name="Num_departamento" not-null="true"/> 
            </key> 
            <one-to-many class="POJOS.Lugar"/> 
        </set>
           
    </class>
    
</hibernate-mapping>
