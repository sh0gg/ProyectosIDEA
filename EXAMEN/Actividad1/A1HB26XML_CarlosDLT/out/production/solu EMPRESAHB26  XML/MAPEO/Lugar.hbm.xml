<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="POJOS">
    <class name="Lugar" table="LUGAR" schema="dbo" catalog="EMPRESAHB26">
        <!-- generado por Hibernate -->
        <id name="id" column="ID" type="int">
            <generator class="increment"/>
        </id>
            <property name="lugar" type="string">
            <column name="Lugar" length="15" not-null="true"/>
        </property>

        <!-- Mapeo del lugar  de un departeemenyo -->
        <many-to-one name="departamento" class="POJOS.Departamento"   fetch="select">
            <column name="Num_departamento" not-null="true"/>
        </many-to-one>

    </class>

</hibernate-mapping>
