<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="POJOS.Pasteleria" table="PASTELERIA" schema="dbo" catalog="HBPASTELERIA26" >
       <id name="codigo" type="int">
            <column name="codigo" />
            <generator class="identity" />
      </id>       
        <property name="nome" type="string" unique="true">
            <column name="Nome" length="30" not-null="true"  />
        </property>
        <property name="categoria" type="string">
            <column name="Categoria" length="40" />
        </property>
        <property name="localidade" type="string">
            <column name="Localidade" length="40" not-null="true" />
        </property>

        <!-- relacion con Pastelero -->
        <many-to-one class="POJOS.Pastelero" fetch="select" name="dueno">
            <column length="4" name="Codpastelero"/>
        </many-to-one>

        <!-- Set de pastelerias -->
        <set fetch="select" inverse="true" lazy="true" name="productos" table="PRODUCTO">
            <key>
                <column name="Codigo"/>
            </key>
            <many-to-many class="POJOS.Producto"/>
        </set>
    </class>
</hibernate-mapping>
