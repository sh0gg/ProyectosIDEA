<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="POJOS.Proxecto" table="PROXECTO" schema="dbo" catalog="EMPRESAHB26">
        <id name="numProxecto" type="int">
            <column name="NumProxecto" />
            <generator class="increment" />
        </id>
        <property name="nomeProxecto" type="string">
            <column name="NomeProxecto" length="25" not-null="true" unique="true" />
        </property>
        <property name="lugar" type="string">
            <column name="Lugar" length="25" not-null="true" />
        </property>
        <!-- mapear las fase de proyecto como componente         -->
        <set name="fases" table="PROXECTOFASE">
            <key column="NumProxecto"/> 
            <composite-element class="POJOS.ProxectoFase">
                <property name="nomeFase" column="NombreFase"/>
                <property name="estado" column="Estado"/> 
            </composite-element>            
        </set>
    
    
    
    </class>
</hibernate-mapping>
