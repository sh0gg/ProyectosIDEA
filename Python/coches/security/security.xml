<odoo>
    <record id="group_coches_user" model="res.groups">
        <field name="name">Coches / Usuario</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="rule_coches_company" model="ir.rule">
        <field name="name">Coches: multi-company</field>
        <field name="model_id" ref="model_coches_coche"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('coches.group_coches_user'))]"/>
    </record>
</odoo>
