<odoo>
    <data>
        <record id="colegio_aula_lista" model="ir.ui.view">
            <field name="name">lista aula</field>
            <field name="model">colegio.aula</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="piso"/>
                    <field name="capacidad"/>
                    <field name="disponibilidad"/>
                </tree>
            </field>

        </record>

        <record id="colegio_aula_action_window" model="ir.actions.act_window">
            <field name="name">VentanaAula</field>
            <field name="res_model">colegio.aula</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="colegio_aula_menu_root" name="Aula"/>
        <menuitem id="colegio_aula_menu_1" name="Aulas" parent="colegio_aula_action_window"/>
    </data>
</odoo>